<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      NativeAOT publish smoke test. `dotnet publish` on this project must succeed with zero
      trim/AOT warnings, exercising the core broadcast path (DI registration, subscribe, raw
      publish, channel read) in a rooted, trimmed, native binary. The typed JSON publish
      (SseHubTypedExtensions.Publish<T>) is deliberately not exercised - it is annotated
      RequiresUnreferencedCode/RequiresDynamicCode because it serializes with reflection.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moongazing.OrionStream\Moongazing.OrionStream.csproj" />
  </ItemGroup>
</Project>
