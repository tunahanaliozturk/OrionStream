<Project>
  <PropertyGroup>
    <Version>0.7.0</Version>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Tunahan Ali Ozturk</Authors>
    <Company>Moongazing</Company>
    <Product>OrionStream</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tunahanaliozturk/OrionStream</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tunahanaliozturk/OrionStream</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>icon.png</PackageIcon>
    <!--
      Audit the whole transitive graph (not just direct references, the default), and surface
      package-vulnerability advisories (NU1901-1904) as warnings rather than errors, so a
      newly-disclosed upstream CVE shows up loudly without turning CI red on an external event
      with no code change. Remove WarningsNotAsErrors to make advisories hard build errors.
    -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
</PropertyGroup>
  <!--
    Pack the icon into every packable project from one place. Each csproj packs its own
    docs/README.md as the package readme.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
